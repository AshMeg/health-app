{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xnduiumeflwyqclszcwm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bloom-mcp",
      "version": "0.1.0",
      "title": "Bloom"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get profile and targets",
        "description": "Read the signed-in Bloom user's profile: name, date of birth, biological sex, height, activity level, weight goal and daily calorie/protein/carb/fat targets.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_weight_logs",
        "title": "List weight logs",
        "description": "List the signed-in Bloom user's weight entries (weight in kg, body fat %, notes, source), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 30,
              "description": "How many entries to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "from": {
              "description": "Optional earliest date, YYYY-MM-DD.",
              "type": "string"
            },
            "to": {
              "description": "Optional latest date, YYYY-MM-DD.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_weight",
        "title": "Log a weight entry",
        "description": "Create or update a weight entry for the signed-in Bloom user on a given date. Weight is in kilograms.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": "number",
              "minimum": 20,
              "maximum": 400,
              "description": "Body weight in kilograms."
            },
            "date": {
              "description": "Date of the entry, YYYY-MM-DD. Defaults to today (UTC).",
              "type": "string"
            },
            "body_fat_percent": {
              "description": "Optional body fat percent.",
              "type": "number",
              "minimum": 1,
              "maximum": 70
            },
            "notes": {
              "description": "Optional short note.",
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "weight_kg"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_body_measurements",
        "title": "List body measurements",
        "description": "List the signed-in Bloom user's body measurement entries (waist, chest, hips, neck, arms, thighs, calves in cm), newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many entries to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
